<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/et_storage_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Type something to save" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button android:id="@+id/btn_save" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Save" />
        <Button android:id="@+id/btn_read" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Read" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_storage_display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Saved data will appear here"
        android:textSize="18sp"
        android:layout_marginTop="20dp" />
</LinearLayout>